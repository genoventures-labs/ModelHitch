{
  "name": "modelhitch",
  "version": "0.1.0",
  "description": "Plug-and-play BYOK integration layer — hitch any AI provider or model to your app.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/quickstart.ts"
  },
  "keywords": [
    "ai",
    "llm",
    "byok",
    "bring-your-own-key",
    "provider",
    "openai",
    "anthropic",
    "ollama",
    "groq",
    "openrouter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
